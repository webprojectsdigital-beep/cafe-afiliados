---
// src/layouts/BaseLayout.astro
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

// Si la página es la home, no repetimos el nombre: "Tueste Lento | tagline"
const esHome = Astro.url.pathname === '/';
const tituloCompleto = esHome ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />

    <!-- Aplica el tema guardado ANTES de pintar, para evitar el parpadeo.
         Tiene que ir en el head y sin defer ni async. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#contenido" class="saltar visually-hidden">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Hace que el pie quede abajo aunque la página tenga poco contenido */
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  /* El enlace "saltar" se hace visible solo al tabular hasta él */
  .saltar:focus {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 100;
    width: auto;
    height: auto;
    clip: auto;
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius);
    text-decoration: none;
  }
</style>
