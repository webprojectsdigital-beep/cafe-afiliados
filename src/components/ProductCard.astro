---
// src/components/ProductCard.astro
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string; // enlace a NUESTRA reseña, no al afiliado
  nombre: string;
  categoria: string;
  resumen: string;
  etiqueta?: string;
  image?: ImageMetadata;
}

const { href, nombre, categoria, resumen, etiqueta, image } = Astro.props;
---

<article class="producto card">
  <Media
    src={image}
    alt={image ? nombre : ''}
    ratio="1 / 1"
    label="Foto de producto"
    widths={[400, 800]}
    sizes="(min-width: 62rem) 30vw, (min-width: 36rem) 45vw, 100vw"
  />
  <div class="producto__cuerpo">
    <div class="producto__meta">
      <span class="badge">{categoria}</span>
      {etiqueta && <span class="producto__etiqueta">{etiqueta}</span>}
    </div>
    <h3>
      <a href={href}>{nombre}</a>
    </h3>
    <p>{resumen}</p>
    <span class="producto__cta" aria-hidden="true">
      Leer reseña →
    </span>
  </div>
</article>

<style>
  .producto {
    position: relative;
    padding: 0;
    overflow: hidden;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .producto:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .producto__cuerpo {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .producto__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .producto__etiqueta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .producto h3 {
    font-size: var(--text-lg);
  }

  .producto h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .producto h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .producto p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .producto__cta {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .producto {
      transition: none;
    }
    .producto:hover {
      transform: none;
    }
  }
</style>
