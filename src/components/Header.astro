---
// src/components/Header.astro
import { SITE, NAV } from '../data/site';

// Para marcar en el menú la sección donde estás
const ruta = Astro.url.pathname;
const esActivo = (href: string) => ruta.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo">
      {SITE.name}
    </a>

    <!-- Menú de escritorio -->
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={esActivo(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__acciones">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <span aria-hidden="true" class="theme-toggle__icono">
          ◐
        </span>
      </button>

      <!-- Menú móvil: <details> funciona sin JavaScript -->
      <details class="nav-movil">
        <summary aria-label="Abrir menú">
          <span aria-hidden="true">☰</span>
        </summary>
        <nav aria-label="Principal (móvil)">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .logo {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .site-header__acciones {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* ---------- Menú de escritorio ---------- */
  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .nav-desktop a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ---------- Botón de tema ---------- */
  .theme-toggle,
  .nav-movil summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .nav-movil summary::-webkit-details-marker {
    display: none;
  }

  .theme-toggle:hover,
  .nav-movil summary:hover {
    border-color: var(--color-accent);
  }

  /* ---------- Menú móvil ---------- */
  .nav-movil {
    position: relative;
  }

  .nav-movil nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 14rem;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .nav-movil ul {
    list-style: none;
    padding: 0;
  }

  .nav-movil a {
    display: block;
    padding: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .nav-movil a:hover {
    background: var(--color-bg-alt);
    color: var(--color-accent);
  }

  /* ---------- A partir de tablet: se muestra el menú completo ---------- */
  @media (min-width: 62rem) {
    .nav-desktop {
      display: block;
    }
    .nav-movil {
      display: none;
    }
  }
</style>

<script>
  // Botón de modo oscuro: alterna y guarda la elección del visitante.
  const boton = document.getElementById('theme-toggle');

  boton?.addEventListener('click', () => {
    const html = document.documentElement;
    // Si no hay elección guardada, partimos de lo que marque el sistema
    const actual =
      html.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const nuevo = actual === 'dark' ? 'light' : 'dark';

    html.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {
      // Si el navegador bloquea el almacenamiento, no pasa nada
    }
  });
</script>
