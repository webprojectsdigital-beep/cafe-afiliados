---
// src/components/Media.astro
// Muestra una imagen optimizada o, si no hay, un marcador de posición.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: string; // por ejemplo '4 / 3'
  widths?: number[];
  sizes?: string;
  priority?: boolean; // true SOLO para la imagen principal de la página
  label?: string; // texto del marcador
}

const {
  src,
  alt = '',
  ratio = '4 / 3',
  widths = [400, 800, 1200],
  sizes = '(min-width: 48rem) 33vw, 100vw',
  priority = false,
  label = 'Foto pendiente',
} = Astro.props;
---

<div class="media" style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  ) : (
    <span class="media__ph" aria-hidden="true">
      {label}
    </span>
  )}
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  /* :global porque la etiqueta img la genera el componente Image de Astro */
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-bg-alt), var(--color-sage-soft));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
