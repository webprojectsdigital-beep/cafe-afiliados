---
// src/components/CategoryCard.astro
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  nombre: string;
  texto: string;
  image?: ImageMetadata;
}

const { href, nombre, texto, image } = Astro.props;
---

<article class="cat card">
  <Media
    src={image}
    alt={image ? nombre : ''}
    ratio="4 / 3"
    label={nombre}
    widths={[400, 800]}
    sizes="(min-width: 62rem) 22vw, (min-width: 36rem) 45vw, 100vw"
  />
  <div class="cat__cuerpo">
    <h3>
      <a href={href}>{nombre}</a>
    </h3>
    <p>{texto}</p>
  </div>
</article>

<style>
  .cat {
    position: relative;
    padding: 0;
    overflow: hidden;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .cat:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .cat__cuerpo {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .cat h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .cat h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Hace clicable toda la tarjeta, no solo el título */
  .cat h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cat p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat {
      transition: none;
    }
    .cat:hover {
      transform: none;
    }
  }
</style>
